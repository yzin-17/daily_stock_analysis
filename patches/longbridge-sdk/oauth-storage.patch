diff --git a/rust/crates/oauth/src/thesis_ledger_tests.rs b/rust/crates/oauth/src/thesis_ledger_tests.rs
new file mode 100644
index 0000000..bef0503
--- /dev/null
+++ b/rust/crates/oauth/src/thesis_ledger_tests.rs
@@ -0,0 +1,224 @@
+use crate::{OAuthBuilder, OAuthError, OAuthResult, StoredToken, TokenStorage};
+use oauth2::{PkceCodeChallenge, PkceCodeVerifier};
+use poem::{
+    EndpointExt, Route, Server, handler,
+    listener::{Listener, TcpListener},
+    web::{Data, Form, Json},
+};
+use std::{
+    collections::HashMap,
+    sync::{Arc, Mutex},
+    time::Duration,
+};
+
+#[derive(Clone)]
+struct Storage {
+    saved: Arc<Mutex<Vec<StoredToken>>>,
+    fail: bool,
+}
+impl TokenStorage for Storage {
+    fn load(&self, _: &str) -> Option<StoredToken> {
+        None
+    }
+    fn save(&self, value: &StoredToken) -> OAuthResult<()> {
+        if self.fail {
+            return Err(OAuthError::Other("store unavailable".into()));
+        }
+        self.saved.lock().unwrap().push(value.clone());
+        Ok(())
+    }
+}
+
+#[handler]
+async fn token_endpoint(
+    Form(form): Form<HashMap<String, String>>,
+    expected: Data<&Arc<Mutex<String>>>,
+) -> Json<serde_json::Value> {
+    if form.get("grant_type").map(String::as_str) == Some("authorization_code") {
+        let verifier =
+            PkceCodeVerifier::new(form.get("code_verifier").expect("PKCE verifier").clone());
+        let challenge = PkceCodeChallenge::from_code_verifier_sha256(&verifier);
+        assert_eq!(challenge.as_str(), expected.lock().unwrap().as_str());
+        Json(
+            serde_json::json!({"access_token":"initial", "refresh_token":"refresh",
+            "token_type":"Bearer", "expires_in":1}),
+        )
+    } else {
+        assert_eq!(
+            form.get("refresh_token").map(String::as_str),
+            Some("refresh")
+        );
+        Json(
+            serde_json::json!({"access_token":"renewed", "token_type":"Bearer", "expires_in":3600}),
+        )
+    }
+}
+
+async fn authorize(fail_storage: bool) {
+    use poem::listener::Acceptor;
+    let listener = TcpListener::bind("127.0.0.1:0")
+        .into_acceptor()
+        .await
+        .unwrap();
+    let address = listener.local_addr()[0]
+        .as_socket_addr()
+        .unwrap()
+        .to_string();
+    let expected = Arc::new(Mutex::new(String::new()));
+    let server = tokio::spawn(
+        Server::new_with_acceptor(listener).run(
+            Route::new()
+                .at("/token", poem::post(token_endpoint))
+                .data(expected.clone()),
+        ),
+    );
+    let base: &'static str = Box::leak(format!("http://{address}").into_boxed_str());
+    let saved = Arc::new(Mutex::new(Vec::new()));
+    crate::client::TEST_OAUTH_BASE
+        .scope(base, async {
+            let (tx, rx) = tokio::sync::oneshot::channel::<String>();
+            let tx = Mutex::new(Some(tx));
+            let builder = OAuthBuilder::new("test-client")
+                .callback_port(0)
+                .authorization_timeout_secs(5)
+                .token_storage(Storage {
+                    saved: saved.clone(),
+                    fail: fail_storage,
+                });
+            let build = builder.build(|url| {
+                let _ = tx.lock().unwrap().take().unwrap().send(url.to_string());
+            });
+            let callback = async {
+                let url = oauth2::url::Url::parse(&rx.await.unwrap()).unwrap();
+                let query: HashMap<String, String> = url.query_pairs().into_owned().collect();
+                assert_eq!(
+                    query.get("code_challenge_method").map(String::as_str),
+                    Some("S256")
+                );
+                *expected.lock().unwrap() = query["code_challenge"].clone();
+                let response = reqwest::Client::new()
+                    .get(&query["redirect_uri"])
+                    .query(&[("code", "fixture-code"), ("state", query["state"].as_str())])
+                    .send()
+                    .await
+                    .unwrap();
+                assert_eq!(response.headers()["cache-control"], "no-store");
+                assert!(
+                    response
+                        .text()
+                        .await
+                        .unwrap()
+                        .contains("请返回应用查看授权结果")
+                );
+            };
+            let (result, ()) = tokio::join!(build, callback);
+            if fail_storage {
+                assert!(result.is_err());
+                assert!(saved.lock().unwrap().is_empty());
+            } else {
+                let oauth = result.unwrap();
+                assert_eq!(oauth.access_token().await.unwrap(), "renewed");
+                let tokens = saved.lock().unwrap();
+                assert_eq!(tokens.len(), 2);
+                assert_eq!(tokens[0].access_token, "initial");
+                assert_eq!(tokens[1].access_token, "renewed");
+                assert_eq!(tokens[1].refresh_token.as_deref(), Some("refresh"));
+            }
+        })
+        .await;
+    server.abort();
+}
+
+#[tokio::test]
+async fn thesis_ledger_pkce_and_refresh_persist_through_custom_storage() {
+    tokio::time::timeout(Duration::from_secs(10), authorize(false))
+        .await
+        .unwrap();
+}
+
+#[tokio::test]
+async fn thesis_ledger_storage_failure_aborts_authorization() {
+    tokio::time::timeout(Duration::from_secs(10), authorize(true))
+        .await
+        .unwrap();
+}
+
+#[tokio::test]
+async fn thesis_ledger_unattended_request_never_opens_authorization() {
+    let result = OAuthBuilder::new("test-client")
+        .allow_authorization(false)
+        .token_storage(Storage {
+            saved: Arc::new(Mutex::new(Vec::new())),
+            fail: false,
+        })
+        .build(|_| panic!("must not open browser"))
+        .await;
+    assert!(result.is_err());
+}
+
+#[tokio::test]
+async fn thesis_ledger_cancel_releases_callback_listener() {
+    use poem::listener::Acceptor;
+    let listener = TcpListener::bind("127.0.0.1:0")
+        .into_acceptor()
+        .await
+        .unwrap();
+    let address = listener.local_addr()[0]
+        .as_socket_addr()
+        .unwrap()
+        .to_string();
+    let task = tokio::spawn(crate::callback::wait_for_callback(
+        listener,
+        600,
+        "expected".into(),
+    ));
+    tokio::task::yield_now().await;
+    task.abort();
+    let _ = task.await;
+    tokio::time::timeout(Duration::from_secs(1), async {
+        loop {
+            if let Ok(listener) = tokio::net::TcpListener::bind(&address).await {
+                drop(listener);
+                break;
+            }
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .unwrap();
+}
+
+#[tokio::test]
+async fn thesis_ledger_invalid_state_cannot_consume_callback() {
+    use poem::listener::Acceptor;
+    let listener = TcpListener::bind("127.0.0.1:0")
+        .into_acceptor()
+        .await
+        .unwrap();
+    let address = listener.local_addr()[0]
+        .as_socket_addr()
+        .unwrap()
+        .to_string();
+    let task = tokio::spawn(crate::callback::wait_for_callback(
+        listener,
+        5,
+        "expected".into(),
+    ));
+    let client = reqwest::Client::new();
+    let url = format!("http://{address}/callback");
+    let response = client
+        .get(&url)
+        .query(&[("code", "bad"), ("state", "wrong")])
+        .send()
+        .await
+        .unwrap();
+    assert_eq!(response.status(), reqwest::StatusCode::BAD_REQUEST);
+    assert!(!task.is_finished());
+    let _ = client
+        .get(&url)
+        .query(&[("error", "access_denied"), ("state", "expected")])
+        .send()
+        .await;
+    let error = task.await.unwrap().err().unwrap().to_string();
+    assert!(error.contains("access_denied"));
+}
