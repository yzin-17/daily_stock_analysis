+fn parse_token(client_id: &str, raw: &str) -> PyResult<StoredToken> {
+    let invalid = || PyValueError::new_err("Invalid OAuth token payload");
+    let value: serde_json::Value = serde_json::from_str(raw).map_err(|_| invalid())?;
+    let id = value
+        .get("client_id")
+        .and_then(|v| v.as_str())
+        .ok_or_else(invalid)?;
+    let access = value
+        .get("access_token")
+        .and_then(|v| v.as_str())
+        .ok_or_else(invalid)?;
+    let expires = value
+        .get("expires_at")
+        .and_then(|v| v.as_u64())
+        .ok_or_else(invalid)?;
+    let refresh = match value.get("refresh_token") {
+        None | Some(serde_json::Value::Null) => None,
+        Some(serde_json::Value::String(value)) if !value.is_empty() => Some(value.clone()),
+        _ => return Err(invalid()),
+    };
+    if id != client_id || access.is_empty() {
+        return Err(invalid());
+    }
+    Ok(StoredToken {
+        client_id: id.to_string(),
+        access_token: access.to_string(),
+        refresh_token: refresh,
+        expires_at: expires,
+    })
