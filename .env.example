# 数据服务示例。复制前填写自身配置；此文件不包含真实凭据。
# 默认关闭 fixture 和公共搜索实例。数据源准入、目标探测仍需独立确认。
THESIS_LEDGER_DSA_TOKEN=
THESIS_LEDGER_CONTROL_TOKEN=
THESIS_LEDGER_FIXTURE_MODE=false

# 控制面密钥用于加密持久化的 Provider 凭据；实际格式和轮换见部署说明。
# THESIS_LEDGER_DSA_SECRET_KEY=
# THESIS_LEDGER_DSA_SECRET_KEY_VERSION=
# THESIS_LEDGER_DSA_SECRET_KEY_PREVIOUS=
# THESIS_LEDGER_DSA_SECRET_KEY_PREVIOUS_VERSION=

# 行情与基本面凭据；留空表示未提供，不能代替真实 SDK 或数据源验收。
TUSHARE_TOKEN=
TICKFLOW_API_KEY=
TICKFLOW_KLINE_ADJUST=none
TICKFLOW_PRIORITY=2
TICKFLOW_BATCH_DAILY_ENABLED=true
TICKFLOW_BATCH_SIZE=100
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=
LONGBRIDGE_OAUTH_CLIENT_ID=
# LONGBRIDGE_OAUTH_TOKEN_CACHE_B64=
# THESIS_LEDGER_OAUTH_CALLBACK_HOST=

# 数据查询与缓存。股票索引使用随包种子，远端刷新需显式开启。
STOCK_INDEX_REMOTE_UPDATE_ENABLED=false
PREFETCH_REALTIME_QUOTES=true
ENABLE_REALTIME_QUOTE=true
ENABLE_CHIP_DISTRIBUTION=true
ENABLE_EASTMONEY_PATCH=false
REALTIME_SOURCE_PRIORITY=tencent,akshare_sina,efinance,akshare_em
REALTIME_CACHE_TTL=600
ENABLE_FUNDAMENTAL_PIPELINE=true
FUNDAMENTAL_STAGE_TIMEOUT_SECONDS=8
FUNDAMENTAL_FETCH_TIMEOUT_SECONDS=8
FUNDAMENTAL_RETRY_MAX=1
FUNDAMENTAL_CACHE_TTL_SECONDS=120
FUNDAMENTAL_CACHE_MAX_ENTRIES=256

# 原始新闻搜索。密钥可用逗号分隔；不启用摘要或模型生成。
ANSPIRE_API_KEYS=
BOCHA_API_KEYS=
MINIMAX_API_KEYS=
TAVILY_API_KEYS=
BRAVE_API_KEYS=
SERPAPI_API_KEYS=
# SearXNG 使用专属实例地址，多个地址以逗号分隔；无需把公开实例地址当作密钥。
SEARXNG_BASE_URLS=
SEARXNG_PUBLIC_INSTANCES_ENABLED=false
NEWS_MAX_AGE_DAYS=3
NEWS_STRATEGY_PROFILE=short

# 保留现有数据库路径；升级不可通过替换文件或清库完成。
DATABASE_PATH=./data/stock_analysis.db
SQLITE_WAL_ENABLED=true
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_WRITE_RETRY_MAX=3
SQLITE_WRITE_RETRY_BASE_DELAY=0.1
LOG_DIR=./logs
LOG_LEVEL=INFO

# HTTP 服务由 Uvicorn 参数设置 host/port；跨域默认关闭全量放行。
CORS_ALLOW_ALL=false
CORS_ORIGINS=

# 代理遵循标准环境变量；按需取消注释，不写入真实认证信息。
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1
